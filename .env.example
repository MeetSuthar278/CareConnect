FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=replace-with-random-local-secret
DATABASE_URL=mysql+pymysql://careconnect:replace-with-private-database-password@127.0.0.1:3307/careconnect_db
MYSQL_ROOT_PASSWORD=replace-with-private-root-password
MYSQL_DATABASE=careconnect_db
MYSQL_USER=careconnect
MYSQL_PASSWORD=replace-with-private-database-password

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=careconnect_db
DB_USER=careconnect
DB_PASSWORD=replace-with-private-database-password

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_USER=careconnect
RABBITMQ_PASSWORD=replace-with-private-broker-password
RABBITMQ_VHOST=/

# Firebase configuration
FIREBASE_PROJECT_ID=careconnect-bfb9e
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=careconnect-bfb9e.firebaseapp.com
FIREBASE_STORAGE_BUCKET=careconnect-bfb9e.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/private/firebase-admin.json

# Host-run processes use MySQL 3307 and RabbitMQ 5673 (docker-compose.yml).
# Preserve local credentials; do not overwrite an existing .env.
# Container-to-container connections use mysql:3306 and rabbitmq:5672.
