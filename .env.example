FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=replace-with-random-local-secret
DATABASE_URL=mysql+pymysql://careconnect:careconnect_dev_password@127.0.0.1:3307/careconnect_db

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=careconnect_db
DB_USER=careconnect
DB_PASSWORD=careconnect_dev_password

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_USER=careconnect
RABBITMQ_PASSWORD=rabbitmq_dev_password
RABBITMQ_VHOST=/

# Host-run processes use MySQL 3307 and RabbitMQ 5673 (docker-compose.yml).
# Preserve local credentials; do not overwrite an existing .env.
# Container-to-container connections use mysql:3306 and rabbitmq:5672.
