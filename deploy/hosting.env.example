# Copy privately to deploy/.env.hosting on the VM; never commit the filled copy.
SITE_DOMAIN=careconnect.example.com
SECRET_KEY=replace-with-a-new-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-new-random-root-password
MYSQL_DATABASE=careconnect_db
MYSQL_USER=careconnect
MYSQL_PASSWORD=replace-with-a-new-random-database-password
# Use the same MYSQL_* values above. URL-encode special characters in URL passwords.
DATABASE_URL=mysql+pymysql://careconnect:replace-with-a-new-random-database-password@mysql:3306/careconnect_db
RABBITMQ_USER=careconnect
RABBITMQ_PASSWORD=replace-with-a-new-random-broker-password
FIREBASE_PROJECT_ID=careconnect-7132c
# Absolute private path on Linux; the container reads it as a runtime secret.
FIREBASE_ADMIN_JSON=/opt/careconnect-secrets/firebase-admin.json
